{
  "name": "prompt-enhancer",
  "displayName": "Prompt Enhancer",
  "description": "Turn a rough thought into a prompt worth sending. Bring your own Anthropic, OpenAI or Google AI key.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "geoffreyzulu",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "AI",
    "Chat",
    "Education"
  ],
  "keywords": [
    "prompt",
    "prompt engineering",
    "ai",
    "anthropic",
    "claude",
    "openai",
    "chatgpt",
    "gemini",
    "llm"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:promptEnhancer.insertResult",
    "onCommand:promptEnhancer.copyResult"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptEnhancer",
          "title": "Prompt Enhancer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "promptEnhancer": [
        {
          "type": "webview",
          "id": "promptEnhancer.panel",
          "name": "Enhance a prompt",
          "icon": "media/icon.svg",
          "contextualTitle": "Prompt Enhancer"
        }
      ]
    },
    "commands": [
      {
        "command": "promptEnhancer.enhancePrompt",
        "title": "Enhance a Prompt…",
        "category": "Prompt Enhancer"
      },
      {
        "command": "promptEnhancer.openPanel",
        "title": "Open Panel",
        "category": "Prompt Enhancer"
      },
      {
        "command": "promptEnhancer.enhanceSelection",
        "title": "Enhance Selection (rewrite in place)",
        "category": "Prompt Enhancer"
      },
      {
        "command": "promptEnhancer.setApiKey",
        "title": "Set API Key",
        "category": "Prompt Enhancer"
      },
      {
        "command": "promptEnhancer.clearApiKey",
        "title": "Clear API Key",
        "category": "Prompt Enhancer"
      },
      {
        "command": "promptEnhancer.selectModel",
        "title": "Select Model",
        "category": "Prompt Enhancer"
      }
    ],
    "keybindings": [
      {
        "command": "promptEnhancer.enhancePrompt",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "promptEnhancer.enhanceSelection",
          "when": "editorHasSelection",
          "group": "1_modification@100"
        }
      ]
    },
    "configuration": {
      "title": "Prompt Enhancer",
      "properties": {
        "promptEnhancer.defaultMode": {
          "type": "string",
          "enum": [
            "code",
            "architecture",
            "refactor"
          ],
          "enumDescriptions": [
            "Push for a prompt that yields working code.",
            "Push for a prompt that yields a design, not an implementation.",
            "Push for a prompt that yields a behaviour-preserving change."
          ],
          "default": "code",
          "markdownDescription": "Mode used by **Enhance a Prompt…** and the editor command. The panel has its own picker."
        },
        "promptEnhancer.provider": {
          "type": "string",
          "enum": [
            "",
            "anthropic",
            "openai",
            "google"
          ],
          "enumDescriptions": [
            "Ask once and remember (the default).",
            "Use the stored Anthropic key.",
            "Use the stored OpenAI key.",
            "Use the stored Google AI key."
          ],
          "default": "",
          "markdownDescription": "Which provider to use when you have more than one API key stored. Ignored when only one key is stored, and ignored if it names a provider you have no key for- the key you actually have is a better answer than an error. Leave empty to be asked once and have the choice remembered."
        },
        "promptEnhancer.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model ID to use, overriding the model chosen with your API key. Leave empty to use the model picked by **Prompt Enhancer: Select Model**. Validated when it is used, so a typo shows up as \"model not available\" rather than being ignored. No model ID is hardcoded in this extension- run **Select Model** to see the ones your key can use."
        }
      }
    }
  },
  "scripts": {
    "deps": "pnpm --filter @prompt-enhancer/prompts build",
    "prebuild": "pnpm run deps",
    "build": "tsup",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "watch": "tsup --watch",
    "pretypecheck": "pnpm run deps",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm run build",
    "pretest": "pnpm run deps",
    "test": "vitest run",
    "pretest:live": "pnpm run deps",
    "test:live": "vitest run src/providers/live.test.ts",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "pretest:integration": "pnpm run build && pnpm run compile:integration",
    "test:integration": "node out/integration/runTest.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@google/genai": "^2.17.1",
    "@prompt-enhancer/prompts": "workspace:*",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.16.11",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Geoffrey-Zulu/prompt-enhancer.git"
  },
  "bugs": {
    "url": "https://github.com/Geoffrey-Zulu/prompt-enhancer/issues"
  },
  "homepage": "https://github.com/Geoffrey-Zulu/prompt-enhancer#readme"
}
