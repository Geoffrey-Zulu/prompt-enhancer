{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // tsup does the emitting; tsc is only ever run with --noEmit here, so
    // rootDir/outDir would serve no purpose and would exclude tsup.config.ts.
    "noEmit": true,
    "types": ["node", "vscode"],
    "declaration": false,
    "declarationMap": false
  },
  // vitest.config.ts is deliberately absent: it is ESM-native (`vitest/config`
  // and `import.meta.url`) and cannot be typechecked under this package's
  // Node16/CommonJS settings. Vitest type-strips it itself.
  "include": ["src/**/*.ts", "test/**/*.ts", "tsup.config.ts"]
}
